PRODKIT_STORAGE_DATABASE_URL=postgresql://prodkit:prodkit@127.0.0.1:5432/prodkit
# Optional explicit drivers / read replicas:
# PRODKIT_STORAGE_SYNC_DATABASE_URL=postgresql+psycopg://...
# PRODKIT_STORAGE_ASYNC_DATABASE_URL=postgresql+asyncpg://...
# PRODKIT_STORAGE_READ_DATABASE_URL=postgresql://...
# PRODKIT_STORAGE_ASYNC_READ_DATABASE_URL=postgresql+asyncpg://...

PRODKIT_STORAGE_REDIS_URL=redis://127.0.0.1:6379/0
PRODKIT_STORAGE_APPLICATION_NAME=prodkit-storage
# Comma-separated modules that import models inheriting prodkit_storage.Base:
# PRODKIT_STORAGE_ALEMBIC_MODEL_MODULES=myapp.models,myapp.billing.models
PRODKIT_STORAGE_POOL_SIZE=10
PRODKIT_STORAGE_MAX_OVERFLOW=20
PRODKIT_STORAGE_STATEMENT_TIMEOUT_MS=30000
PRODKIT_STORAGE_LOCK_TIMEOUT_MS=5000
PRODKIT_STORAGE_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
PRODKIT_STORAGE_TENANT_RLS_ENABLED=false
PRODKIT_STORAGE_TENANT_REQUIRED=false
PRODKIT_STORAGE_CURSOR_SIGNING_SECRET=replace-with-at-least-32-random-bytes
